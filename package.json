{
  "name": "bet-with-friends",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts --port=3001",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "seed": "tsx server/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "11.8.1",
    "cookie-parser": "1.4.7",
    "express": "4.22.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "4.17.21",
    "@types/node": "20.17.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.1.0",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vite": "6.4.4"
  }
}
